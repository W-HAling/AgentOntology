{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentontology.local/contracts/schemas/governance/user-requirement.v1.schema.json",
  "title": "User Requirement v1",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "version",
    "title",
    "statement",
    "source_refs",
    "verbatim_quotes",
    "actors",
    "problem",
    "desired_outcome",
    "priority",
    "constraints",
    "acceptance_signals",
    "confidence",
    "status",
    "confirmation_evidence_ref",
    "confirmed_subject",
    "confirmed_at",
    "supersedes"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^UR-[A-Z0-9]+-[0-9]{3}$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVD-[A-Z0-9]+-[0-9]{3}$"
      }
    },
    "verbatim_quotes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^QUOTE-[A-Z0-9]+-[0-9]{3}$"
      }
    },
    "actors": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "desired_outcome": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3",
        "unranked"
      ]
    },
    "constraints": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "acceptance_signals": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "validated",
        "confirmed",
        "superseded",
        "rejected"
      ]
    },
    "confirmation_evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^APR-[A-Z0-9-]+$"
    },
    "confirmed_subject": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{8,}$"
    },
    "confirmed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^UR-[A-Z0-9]+-[0-9]{3}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "confirmation_evidence_ref": {
            "type": "string"
          },
          "confirmed_subject": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "confirmation_evidence_ref": {
            "type": "null"
          },
          "confirmed_subject": {
            "type": "null"
          },
          "confirmed_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "unevaluatedProperties": false
}
