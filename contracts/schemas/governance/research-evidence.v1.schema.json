{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentontology.local/contracts/schemas/governance/research-evidence.v1.schema.json",
  "title": "Research Evidence v1",
  "type": "object",
  "required": [
    "$schema",
    "id",
    "version",
    "path",
    "media_type",
    "captured_at",
    "source",
    "access_level",
    "digest",
    "classification",
    "status"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^EVD-[A-Z0-9]+-[0-9]{3}$"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "path": {
      "$ref": "#/$defs/repositoryPath"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-zA-Z0-9.+-]+$"
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "access_level": {
      "type": "string",
      "enum": [
        "repository",
        "restricted",
        "confidential",
        "unknown"
      ]
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "classification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "verbatim",
          "interpretation",
          "hypothesis",
          "derived"
        ]
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "validated",
        "invalidated"
      ]
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVD-[A-Z0-9]+-[0-9]{3}$"
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*//)[^\\u0000]+$"
    }
  },
  "unevaluatedProperties": false
}
